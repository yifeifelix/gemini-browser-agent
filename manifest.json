{
  "manifest_version": 3,
  "name": "Gemini Browser Agent",
  "version": "2.2.0",
  "description": "An agentic browser assistant powered by Gemini, using your own Google AI Studio API key (free tier).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Gemini Browser Agent"
  }
}
